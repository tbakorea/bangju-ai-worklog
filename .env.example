# Vercel server environment variables. Never put the real key in app.js or Git.
OPENAI_API_KEY=your_openai_api_key

# Optional: defaults to the current flagship alias.
OPENAI_COACH_MODEL=gpt-5.6

# Local Dagym browser -> Vercel monthly PT schedule sync.
# Set the same long random value in Vercel and the local .env.local file.
DAGYM_BROWSER_SYNC_SECRET=replace_with_a_long_random_secret
DAGYM_MONTHLY_SCHEDULE_URL=https://bangju-ai-worklog.vercel.app/api/dagym-monthly-schedule

# Existing server-only secret used to encrypt member names at rest.
MEMBER_CONTACT_ENCRYPTION_KEY=replace_with_a_long_random_encryption_key
